# Copie para .env.local (desenvolvimento) e preencha. Nunca faça commit de .env.local.

# ---------------- Supabase (banco + autenticação) ----------------
# Banco: Supabase > Connect (botão no topo) > "Transaction pooler" (porta 6543)
# Troque [YOUR-PASSWORD] pela senha do banco definida ao criar o projeto.
DATABASE_URL=

# Autenticação: Supabase > Project Settings > API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente servidor (criação de usuários pelo admin e script seed:admin). NUNCA expor.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------- PedidoOK (somente servidor) ----------------
PEDIDOOK_TOKEN_PARCEIRO=
PEDIDOOK_TOKEN=

# Segredo das rotas de cron (a Vercel envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Pet Intelligence AI (Fase 6) — só servidor. Basta a chave do provedor escolhido
# em Pet Intelligence AI → Provedor (padrão: Claude).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
